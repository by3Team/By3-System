# By3 系统环境变量示例
# 复制本文件为 .env 后，根据实际环境修改对应值

# PostgreSQL 连接配置（Docker Compose 中使用）
POSTGRES_PASSWORD=123456

# 后端数据库连接字符串
# 本地开发：Database=by3_dev
# Docker 生产：Host=postgres;Port=5432;Database=by3;Username=postgres;Password=123456
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=by3_dev;Username=postgres;Password=123456

# JWT 配置（Key 长度至少 32 字节，生产环境必须替换为强密钥）
Jwt__Key=your-super-secret-key-at-least-32-bytes-long!
Jwt__Issuer=By3
Jwt__Audience=By3Client

# CORS 允许的前端地址（多个用逗号分隔）
Cors__AllowedOrigins=http://localhost:5175

# 手机号等敏感数据加密密钥（生产环境必须替换）
DataProtection__EncryptionKey=By3DevPhoneEncryptionKey-ChangeInProd!

# 文件上传存储路径
FileStorage__UploadPath=./uploads

# 人员数据种子任务的默认密码
Jobs__UserSeed__DefaultPassword=Demo123!

# 数据库表前缀
TablePrefix=by3_

# ASP.NET Core 环境
ASPNETCORE_ENVIRONMENT=Development
